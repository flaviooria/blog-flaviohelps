---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteBar from "../components/SiteBar.astro";
import SiteFoot from "../components/SiteFoot.astro";
import PostLog from "../components/PostLog.astro";
import Image from "astro/components/Image.astro";
import { SITE_DESCRIPTION } from "../consts";
import { blog } from "../data/blog";
import { profile } from "../data/profile";
import { getPosts, tagSlug } from "../utils";
import Bot from "@lucide/astro/icons/bot";
import Server from "@lucide/astro/icons/server";
import Container from "@lucide/astro/icons/container";

// Icono de cada tema; la clave es `icon` en src/data/blog.ts.
const icons = { bot: Bot, server: Server, container: Container };

const posts = await getPosts();
const latest = posts.slice(0, 6);
// Sin posts no se ofrecen enlaces a una lista vacía.
const hasPosts = posts.length > 0;
// Los chips de cada tema enlazan a su tag si ya hay posts con él.
const tags = new Set(posts.flatMap((p) => p.data.tags.map(tagSlug)));
const [role] = profile.headline.split("|").map((s) => s.trim());
// Perfiles profesionales junto al nombre: lo primero que busca un reclutador.
const profiles = profile.links.filter((l) =>
  ["GitHub", "LinkedIn"].includes(l.label),
);
---

<BaseLayout description={SITE_DESCRIPTION}>
  <div class="page">
    <SiteBar />

    <main>
      <header class="hero home-hero">
        <p class="path">
          <b>~/blog</b> $ cat README.md
        </p>
        {/* Quién escribe, en el H1: lo primero que lee un reclutador. */}
        <h1>
          Hola, soy <span class="who">{profile.name}</span>, te doy la
          bienvenida. {blog.title}
        </h1>
        <p class="lede">{blog.intro}</p>
        <div class="home-author">
          <Image
            src={profile.avatar}
            alt=""
            width="44"
            height="44"
            densities={[1, 2]}
            loading="eager"
          />
          <div>
            <p class="role">{role}</p>
            <p class="author-meta">
              {profiles.map((l) => (
                <a href={l.href} rel="me">
                  {l.label}
                </a>
              ))}
              <a href="/about-me/">sobre mí</a>
            </p>
          </div>
        </div>
        {hasPosts && (
          <div class="cta">
            <a class="btn primary" href="/blog/">
              Leer el blog <span aria-hidden="true">→</span>
            </a>
          </div>
        )}
      </header>

      <section class="home-section" aria-labelledby="log-title">
        <h2 id="log-title" class="kicker">
          <span aria-hidden="true">// </span>bitácora
        </h2>
        <PostLog posts={latest} />
        {posts.length > latest.length && (
          <a class="more-link" href="/blog/">
            ls ~/blog<span class="sr-only">: todos los posts</span>{" "}
            <span aria-hidden="true">→</span>
          </a>
        )}
      </section>

      <section class="home-section" aria-labelledby="topics-title">
        <h2 id="topics-title" class="kicker">
          <span aria-hidden="true">// </span>de qué va
        </h2>
        <ul class="home-topics">
          {blog.topics.map((t) => {
            const Icon = icons[t.icon];
            return (
              <li>
                <h3>
                  <Icon class="topic-icon" size={18} aria-hidden="true" />
                  {t.title}
                </h3>
                <div>
                  <p>{t.text}</p>
                  <ul class="chips">
                    {t.stack.map((s) =>
                      tags.has(tagSlug(s)) ? (
                        <li>
                          <a href={`/tags/${tagSlug(s)}/`}>{s}</a>
                        </li>
                      ) : (
                        <li>{s}</li>
                      ),
                    )}
                  </ul>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    </main>

    <SiteFoot />
  </div>
</BaseLayout>
