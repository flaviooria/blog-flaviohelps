---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteBar from "../../components/SiteBar.astro";
import SiteFoot from "../../components/SiteFoot.astro";
import PostLog from "../../components/PostLog.astro";
import { getPosts, tagSlug } from "../../utils";

const posts = await getPosts();
const tagCount = new Set(posts.flatMap((p) => p.data.tags.map(tagSlug))).size;
const plural = (n: number, one: string, many: string) =>
  `${n} ${n === 1 ? one : many}`;
---

<BaseLayout
  title="Posts"
  description="Todos los posts de Flavio Oria sobre IA y agentes, backend con Python e infraestructura self-hosted, del más reciente al más antiguo."
>
  <div class="page">
    <SiteBar />
    <main>
      <header class="hero">
        <p class="path">
          <b>~/blog</b> $ ls -t
        </p>
        <h1>Todo lo que he montado, roto y arreglado</h1>
        {posts.length > 0 && (
          <p class="meta">
            {plural(posts.length, "post", "posts")} ·{" "}
            <a href="/tags/">{plural(tagCount, "tag", "tags")}</a> · busca con{" "}
            <kbd>/</kbd>
          </p>
        )}
      </header>
      <section class="log-archive" aria-label="Posts por año">
        <PostLog posts={posts} byYear />
      </section>
    </main>
    <SiteFoot />
  </div>
</BaseLayout>
