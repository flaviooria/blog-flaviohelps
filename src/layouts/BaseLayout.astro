---
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Search from "../components/Search.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL("rss.xml", Astro.site)}
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Aplica el tema guardado antes de pintar (evita parpadeo)
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="ambient" id="ambient" aria-hidden="true">
      <div class="ambient-bounce">
        <div class="ambient-orb">
          <div class="ambient-smoke">
            <span class="puff puff-a"></span>
            <span class="puff puff-b"></span>
            <span class="puff puff-c"></span>
          </div>
          <div class="ambient-sparks">
            <i style="--x:12%;--y:70%;--s:5px;--t:7s;--d:0s;--c:var(--purple)"></i>
            <i style="--x:28%;--y:55%;--s:3px;--t:9s;--d:-2s;--c:var(--pink)"></i>
            <i style="--x:40%;--y:75%;--s:4px;--t:8s;--d:-5s;--c:var(--cyan)"></i>
            <i style="--x:55%;--y:60%;--s:6px;--t:10s;--d:-1s;--c:var(--purple)"></i>
            <i style="--x:66%;--y:72%;--s:3px;--t:7.5s;--d:-4s;--c:var(--pink)"></i>
            <i style="--x:78%;--y:58%;--s:5px;--t:9.5s;--d:-6s;--c:var(--cyan)"></i>
            <i style="--x:22%;--y:45%;--s:4px;--t:11s;--d:-3s;--c:var(--pink)"></i>
            <i style="--x:48%;--y:40%;--s:3px;--t:8.5s;--d:-7s;--c:var(--purple)"></i>
            <i style="--x:70%;--y:42%;--s:4px;--t:10.5s;--d:-2.5s;--c:var(--cyan)"></i>
            <i style="--x:35%;--y:62%;--s:5px;--t:9s;--d:-8s;--c:var(--cyan)"></i>
            <i style="--x:60%;--y:50%;--s:3px;--t:7s;--d:-5.5s;--c:var(--purple)"></i>
            <i style="--x:85%;--y:66%;--s:4px;--t:12s;--d:-9s;--c:var(--pink)"></i>
          </div>
        </div>
      </div>
    </div>
    <script is:inline>
      // Brillo ambiental: cada carga sale de una esquina al azar. Retrasar un
      // eje un trayecto entero equivale a empezar en la pared contraria.
      (function () {
        var s = document.getElementById("ambient").style;
        if (Math.random() < 0.5) s.setProperty("--from-x", "-1");
        if (Math.random() < 0.5) s.setProperty("--from-y", "-1");
      })();
    </script>
    <slot />
    <BackToTop />
    <Search />
    <script>
      const root = document.documentElement;
      const toggles =
        document.querySelectorAll<HTMLButtonElement>(".theme-toggle");
      const currentTheme = () =>
        root.dataset.theme ??
        (matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark");
      // El nombre accesible dice a qué tema se cambia, no solo "cambiar tema".
      const label = () => {
        const text =
          currentTheme() === "light"
            ? "Cambiar a tema oscuro"
            : "Cambiar a tema claro";
        toggles.forEach((btn) => {
          btn.setAttribute("aria-label", text);
          btn.title = text;
        });
      };
      toggles.forEach((btn) => {
        btn.addEventListener("click", () => {
          const next = currentTheme() === "light" ? "dark" : "light";
          root.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
          label();
        });
      });
      matchMedia("(prefers-color-scheme: light)").addEventListener(
        "change",
        label,
      );
      label();
    </script>
  </body>
</html>
