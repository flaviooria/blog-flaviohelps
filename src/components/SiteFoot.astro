---
import { profile } from "../data/profile";
---

<footer class="site-foot">
  <span>
    // © {new Date().getFullYear()} {profile.name}
  </span>
  <ul aria-label="Perfiles y RSS">
    {profile.links.map((l) => (
      <li>
        <a href={l.href} rel={l.label === "RSS" ? undefined : "me"}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</footer>
