---
import type { CollectionEntry } from "astro:content";
import { formatDate, tagSlug } from "../utils";

interface Props {
  posts: CollectionEntry<"blog">[];
  /** 3 cuando la lista va bajo un título de sección (p. ej. en la portada). */
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 2 } = Astro.props;
const Title = headingLevel === 3 ? "h3" : "h2";
---

{posts.length === 0 ? (
  <p class="empty">
    <span aria-hidden="true">// </span>todavía no hay posts
  </p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-card" href={`/blog/${post.id}/`}>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <Title>{post.data.title}</Title>
          <p>{post.data.description}</p>
        </a>
        {post.data.tags.length > 0 && (
          <ul class="stack small" aria-label="Etiquetas">
            {post.data.tags.map((tag) => (
              <li>
                <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
)}
