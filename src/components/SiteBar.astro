---
import { SITE_AUTHOR } from "../consts";
import SearchToggle from "./SearchToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";

// La marca ya lleva a la portada y el RSS está en el pie y en el <head>,
// así que la barra solo tiene las secciones (cabe en una línea a 360px).
const links = [
  { href: "/blog/", label: "Posts" },
  { href: "/tags/", label: "Tags" },
  { href: "/about-me/", label: "Sobre mí" },
];
const path = Astro.url.pathname;
---

<div class="site-bar">
  <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}>
    ~/{SITE_AUTHOR}
  </a>
  <nav aria-label="Principal">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>
        {label}
      </a>
    ))}
    <SearchToggle shortcut />
    <ThemeToggle />
  </nav>
</div>
