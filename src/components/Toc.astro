---
// Índice del post, dibujado como `tree`: carpetas para los capítulos y
// hojas (file-text) para las secciones. En escritorio con ratón vive oculto en el borde izquierdo:
// se abre al pasar el ratón (o al enfocar) por la pestaña y se puede fijar
// como columna. En móvil y en pantallas táctiles es un cajón con botón.
import type { MarkdownHeading } from "astro";
import ListTree from "@lucide/astro/icons/list-tree";
import Pin from "@lucide/astro/icons/pin";
import Folder from "@lucide/astro/icons/folder";
import FolderOpen from "@lucide/astro/icons/folder-open";
import FileText from "@lucide/astro/icons/file-text";

interface Props {
  headings: MarkdownHeading[];
  /** Raíz del árbol (el id del post), como la primera línea de `tree`. */
  root: string;
}

type Item = { heading: MarkdownHeading; children: MarkdownHeading[] };

// depth 1 = capítulo (con subsecciones depth 2); depth 2 antes del primer capítulo = sección suelta
const items: Item[] = [];
for (const h of Astro.props.headings.filter((h) => h.depth <= 2)) {
  const last = items.at(-1);
  if (h.depth === 2 && last && last.heading.depth === 1) last.children.push(h);
  else items.push({ heading: h, children: [] });
}

// Resumen final, como el "3 directories, 12 files" de `tree`
const chapters = items.filter((i) => i.heading.depth === 1).length;
const sections = items.reduce(
  (n, i) => n + i.children.length + (i.heading.depth === 2 ? 1 : 0),
  0,
);
const plural = (n: number, one: string, many: string) =>
  `${n} ${n === 1 ? one : many}`;
---

<div class="toc-dock">
  <div class="toc-handle" aria-hidden="true">
    <ListTree size={16} />
    <span>índice</span>
  </div>
  <nav class="toc" id="toc" aria-label="Índice">
    <div class="toc-head">
      <a class="toc-back" href="/blog/">
        ← cd ~/blog
      </a>
      <button
        class="toc-pin"
        id="tocPin"
        type="button"
        aria-pressed="false"
        aria-label="Fijar el índice"
        title="Fijar el índice"
      >
        <Pin size={14} aria-hidden="true" />
      </button>
    </div>
    <p class="toc-title">// índice</p>
    <p class="toc-root">
      <FolderOpen class="tree-icon" size={15} aria-hidden="true" />
      <span>{Astro.props.root}/</span>
    </p>
    <ul class="toc-tree">
      {items.map(({ heading, children }) => (
        <li class={heading.depth === 1 ? "ch" : undefined}>
          <a href={`#${heading.slug}`}>
            {heading.depth === 1 ? (
              <span class="tree-icon folder" aria-hidden="true">
                <Folder class="closed" size={15} />
                <FolderOpen class="opened" size={15} />
              </span>
            ) : (
              <FileText class="tree-icon" size={14} aria-hidden="true" />
            )}
            <span>{heading.text}</span>
          </a>
          {children.length > 0 && (
            <ul>
              {children.map((c) => (
                <li>
                  <a href={`#${c.slug}`}>
                    <FileText class="tree-icon" size={14} aria-hidden="true" />
                    <span>{c.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <p class="toc-summary">
      {[
        chapters > 0 && plural(chapters, "capítulo", "capítulos"),
        sections > 0 && plural(sections, "sección", "secciones"),
      ]
        .filter(Boolean)
        .join(", ")}
    </p>
  </nav>
</div>
