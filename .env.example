# Copia a .env.prod en el VPS y ajusta los valores.

# Dominio base: el blog se sirve en blog.${DOMAIN}
DOMAIN=flaviohelps.dev

# Imagen en GHCR: ghcr.io/${GHCR_OWNER}/blog-flaviohelps:${IMAGE_TAG}
GHCR_OWNER=flaviooria
# Despliega siempre un SHA concreto (sha-<commit>); latest solo para pruebas
IMAGE_TAG=latest
